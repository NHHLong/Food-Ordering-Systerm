@model List<CartItem>
@{
    ViewData["Title"] = "Cart";
    var voucher = ViewBag.Voucher as Voucher;
}

<h2>Cart</h2>

@if (!Model.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Food</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Food.Name</td>
                    <td>@item.Food.Price.ToString("N0") đ</td>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex gap-2">
                            <input type="hidden" name="foodId" value="@item.Food.FoodId" />
                            <input class="form-control form-control-sm" style="width:90px" type="number" min="1" name="quantity" value="@item.Quantity" />
                            <button class="btn btn-sm btn-outline-primary">Update</button>
                        </form>
                    </td>
                    <td>@item.TotalPrice.ToString("N0") đ</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="foodId" value="@item.Food.FoodId" />
                            <button class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <form asp-action="ApplyVoucher" method="post" class="row g-2 mb-3">
        <div class="col-md-4">
            <input name="code" class="form-control" placeholder="Voucher code" value="@voucher?.Code" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-dark w-100">Apply</button>
        </div>
    </form>

    <div class="mb-3">
        <div>Total: <strong>@(((decimal)ViewBag.Total).ToString("N0")) đ</strong></div>
        <div>Final total: <strong>@(((decimal)ViewBag.FinalTotal).ToString("N0")) đ</strong></div>
    </div>

    <form asp-action="Checkout" method="post" class="border rounded p-3">
        <h5>Checkout</h5>
        <div class="mb-3">
            <label class="form-label">Shipping address</label>
            <input name="shippingAddress" class="form-control" placeholder="Example: 12 Nguyen Trai, District 1" />
        </div>
        <div class="mb-3">
            <label class="form-label">Payment</label>
            <select name="paymentMethod" class="form-select">
                <option value="Cash">Cash</option>
                <option value="BankTransfer">Bank transfer</option>
                <option value="Card">Card</option>
            </select>
        </div>
        <button class="btn btn-success">Place order</button>
    </form>
}
