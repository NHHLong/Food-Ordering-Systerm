@model List<Food>
@{
    ViewData["Title"] = "Menu";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Menu</h2>
    <a class="btn btn-outline-primary" asp-controller="Cart" asp-action="Index">View cart</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Search food" />
    </div>
    <div class="col-md-4">
        <select name="categoryId" class="form-select">
            <option value="">All categories</option>
            @foreach (var category in categories)
            {
                <option value="@category.CategoryId" selected="@(ViewBag.CategoryId == category.CategoryId)">
                    @category.Name
                </option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-dark w-100" type="submit">Search</button>
    </div>
</form>

<div class="row g-3">
    @foreach (var food in Model)
    {
        <div class="col-md-4">
            <div class="card h-100">
                @if (!string.IsNullOrWhiteSpace(food.Image))
                {
                    <img class="card-img-top" src="@food.Image" alt="@food.Name" style="height:180px;object-fit:cover" />
                }
                <div class="card-body">
                    <h5 class="card-title">@food.Name</h5>
                    <p class="text-muted">@food.CategoryName</p>
                    <p>@food.Description</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <strong>@food.Price.ToString("N0") đ</strong>
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="foodId" value="@food.FoodId" />
                            <button class="btn btn-primary btn-sm" type="submit">Add</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
