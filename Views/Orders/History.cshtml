@model List<Order>
@{
    ViewData["Title"] = "Order History";
}

<h2>Order History</h2>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>User</th>
            <th>Date</th>
            <th>Total</th>
            <th>Status</th>
            <th>Payment</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderId</td>
                <td>@order.Username</td>
                <td>@order.OrderDate</td>
                <td>@order.TotalAmount.ToString("N0") đ</td>
                <td>@order.Status</td>
                <td>@order.PaymentMethod</td>
                <td><a asp-action="Details" asp-route-id="@order.OrderId">Details</a></td>
            </tr>
        }
    </tbody>
</table>
