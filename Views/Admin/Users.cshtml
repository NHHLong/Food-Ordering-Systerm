@model List<User>
@{
    ViewData["Title"] = "Manage Users";
}

<h2>Manage Users</h2>
<table class="table">
    <thead><tr><th>Username</th><th>Email</th><th>Phone</th><th>Role</th><th>Active</th><th></th></tr></thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.Email</td>
                <td>@user.Phone</td>
                <td>@user.Role</td>
                <td>@user.IsActive</td>
                <td>
                    <form asp-action="SetUserActive" method="post">
                        <input type="hidden" name="userId" value="@user.UserId" />
                        <input type="hidden" name="isActive" value="@(!user.IsActive)" />
                        <button class="btn btn-sm btn-outline-dark">@(user.IsActive ? "Lock" : "Unlock")</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
