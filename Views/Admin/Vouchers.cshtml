@model List<Voucher>
@{
    ViewData["Title"] = "Manage Vouchers";
}

<h2>Manage Vouchers</h2>
<form asp-action="SaveVoucher" method="post" class="row g-2 border rounded p-3 mb-4">
    <input type="hidden" name="VoucherId" value="0" />
    <div class="col-md-2"><input name="Code" class="form-control" placeholder="Code" /></div>
    <div class="col-md-2"><input name="DiscountPercent" class="form-control" type="number" placeholder="Percent" /></div>
    <div class="col-md-2"><input name="DiscountAmount" class="form-control" type="number" placeholder="Amount" /></div>
    <div class="col-md-2"><input name="MinimumOrderValue" class="form-control" type="number" placeholder="Minimum" /></div>
    <div class="col-md-2"><input name="ExpiryDate" class="form-control" type="date" /></div>
    <input type="hidden" name="StartDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="IsActive" value="true" />
    <div class="col-md-2"><button class="btn btn-primary w-100">Add</button></div>
</form>
<table class="table">
    <thead><tr><th>Code</th><th>Percent</th><th>Amount</th><th>Used</th><th>Expiry</th><th>Active</th></tr></thead>
    <tbody>
        @foreach (var voucher in Model)
        {
            <tr>
                <td>@voucher.Code</td>
                <td>@voucher.DiscountPercent</td>
                <td>@voucher.DiscountAmount</td>
                <td>@voucher.UsedCount / @voucher.MaxUsage</td>
                <td>@voucher.ExpiryDate.ToShortDateString()</td>
                <td>@voucher.IsActive</td>
            </tr>
        }
    </tbody>
</table>
